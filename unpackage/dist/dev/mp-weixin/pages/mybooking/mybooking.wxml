<view class="page"><view class="title">我的预约</view><view class="tabs"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="{{[tab==='all'?'tab on':'tab']}}" bindtap="__e">全部</view><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="{{[tab==='booked'?'tab on':'tab']}}" bindtap="__e">已预约</view><view data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="{{[tab==='pending_pay'?'tab on':'tab']}}" bindtap="__e">确认中</view><view data-event-opts="{{[['tap',[['e3',['$event']]]]]}}" class="{{[tab==='cancelled'?'tab on':'tab']}}" bindtap="__e">已取消</view></view><block wx:if="{{$root.g0}}"><view class="empty"><view class="empty-text">暂无预约记录</view><button data-event-opts="{{[['tap',[['goBooking',['$event']]]]]}}" class="go-btn" bindtap="__e">去订场</button></view></block><block wx:else><view class="list"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="card"><view class="card-top"><view class="court">{{item.$orig.court||'场地'}}</view><view class="{{[item.m0]}}">{{''+item.m1+''}}</view></view><block wx:if="{{item.$orig.venueName}}"><view class="venue">{{item.$orig.venueName}}</view></block><view class="when">{{item.m2+"  "+item.$orig.time}}</view><block wx:if="{{item.$orig.coachName}}"><view class="meta">{{"教练 "+item.$orig.coachName}}</view></block><block wx:if="{{item.$orig.cardName}}"><view class="meta">{{"卡券 "+item.$orig.cardName}}</view></block><block wx:if="{{item.$orig.status==='pending_pay'}}"><view class="meta tip">支付确认中，成功后自动生效；如未扣款可取消占位</view></block><block wx:if="{{item.$orig.status==='booked'}}"><view class="card-bot"><button class="cancel-btn" loading="{{cancellingId===item.$orig._id}}" data-event-opts="{{[['tap',[['onCancel',['$0'],[[['filtered','',index]]]]]]]}}" catchtap="__e">取消预约</button></view></block><block wx:else><block wx:if="{{item.$orig.status==='pending_pay'}}"><view class="card-bot"><button class="cancel-btn" loading="{{cancellingId===item.$orig._id}}" data-event-opts="{{[['tap',[['onCancelPending',['$0'],[[['filtered','',index]]]]]]]}}" catchtap="__e">取消占位</button></view></block></block></view></block></view></block><block wx:if="{{total>0}}"><view class="pagination"><button class="page-btn" disabled="{{page===1}}" data-event-opts="{{[['tap',[['prevPage',['$event']]]]]}}" bindtap="__e">上一页</button><view class="page-info">{{page+" / "+totalPage}}</view><button class="page-btn" disabled="{{page>=totalPage}}" data-event-opts="{{[['tap',[['nextPage',['$event']]]]]}}" bindtap="__e">下一页</button></view></block></view>