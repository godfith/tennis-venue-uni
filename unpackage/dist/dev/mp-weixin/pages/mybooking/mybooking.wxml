<view class="container"><view class="title">我的预约</view><block wx:if="{{$root.g0}}"><view class="empty"><view class="empty-text">暂无预约记录</view><button data-event-opts="{{[['tap',[['goBooking',['$event']]]]]}}" class="go-btn" bindtap="__e">去预约</button></view></block><block wx:else><view class="list"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['list','',index,'_id']]]]]]]}}" class="item" bindtap="__e"><view class="item-left"><view class="court">{{item.$orig.court}}</view><block wx:if="{{item.$orig.venueName||item.$orig.venueId}}"><view class="venue">{{''+item.m0+''}}</view></block><view class="date-time">{{item.$orig.date+"　"+item.$orig.time}}</view><view class="{{['status '+(item.$orig.status==='booked'?'booked':'cancelled')]}}">{{''+(item.$orig.status==='booked'?'已预约':'已取消')+''}}</view></view><view class="item-right"><text class="arrow">›</text></view></view></block></view></block><block wx:if="{{total>0}}"><view class="pagination"><button class="page-btn" disabled="{{page===1}}" data-event-opts="{{[['tap',[['prevPage',['$event']]]]]}}" bindtap="__e">上一页</button><view class="page-info">{{page+" / "+totalPage}}</view><button class="page-btn" disabled="{{page>=totalPage}}" data-event-opts="{{[['tap',[['nextPage',['$event']]]]]}}" bindtap="__e">下一页</button></view></block></view>