<view class="page"><view class="hero"><view class="logo-text">选择注册场馆</view></view><view class="card"><block wx:if="{{loading}}"><view class="empty">加载场馆中...</view></block><block wx:for="{{list}}" wx:for-item="v" wx:for-index="idx" wx:key="idx"><view data-event-opts="{{[['tap',[['onPick',[idx]]]]]}}" class="{{['item',pickedIndex===idx?'active':'']}}" bindtap="__e"><view class="row"><view class="name">{{v.name}}</view><block wx:if="{{v.near}}"><view class="tag">距你最近</view></block></view><block wx:if="{{v.address}}"><view class="addr">{{v.address}}</view></block><block wx:if="{{v.distText}}"><view class="dist">{{v.distText}}</view></block></view></block><block wx:if="{{$root.g0}}"><view class="empty">暂无场馆</view></block><view data-event-opts="{{[['tap',[['askConfirm',['$event']]]]]}}" class="{{['submit-btn',pickedIndex<0?'off':'']}}" bindtap="__e">确认注册场馆</view></view></view>