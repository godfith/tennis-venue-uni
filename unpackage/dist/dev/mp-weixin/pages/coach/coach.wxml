<view class="page"><view class="header">选择教练</view><block wx:if="{{loading}}"><view class="loading">加载中...</view></block><block wx:else><block wx:if="{{$root.g0===0}}"><view class="empty"><view>暂无教练信息</view></view></block><block wx:else><view class="coach-list"><block wx:for="{{coachList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['coachList','',index,'_id']]]]]]]}}" class="coach-card" bindtap="__e"><image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image><view class="info"><view class="name">{{item.name}}</view><view class="title">{{item.title}}</view><view class="desc">{{item.desc}}</view><view class="tags"><block wx:for="{{item.tags}}" wx:for-item="tag" wx:for-index="index1" wx:key="index1"><text class="tag">{{tag}}</text></block></view></view><view class="arrow">›</view></view></block></view></block></block></view>