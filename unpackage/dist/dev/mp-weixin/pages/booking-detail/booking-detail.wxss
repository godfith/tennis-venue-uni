
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 30rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  margin-bottom: 40rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
}
.label {
  color: #999;
}
.value {
  color: #222;
  max-width: 60%;
  text-align: right;
}
.status.booked {
  color: #07c160;
}
.status.cancelled {
  color: #999;
}
.cancel-btn {
  background: #fff !important;
  color: #ff4d4f !important;
  border: 1rpx solid #ff4d4f !important;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 20rpx;
}
.loading {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}

