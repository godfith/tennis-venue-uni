<view class="page"><block wx:if="{{booking}}"><view class="card"><view class="row"><text class="label">订单号</text><text class="value">{{booking.orderNo||booking._id}}</text></view><view class="row"><text class="label">场地</text><text class="value">{{booking.court}}</text></view><view class="row"><text class="label">日期</text><text class="value">{{booking.date}}</text></view><view class="row"><text class="label">时间</text><text class="value">{{booking.time}}</text></view><view class="row"><text class="label">状态</text><text class="{{['status '+(booking.status==='booked'?'booked':'cancelled')]}}">{{''+statusText+''}}</text></view><block wx:if="{{booking.coachName}}"><view class="row"><text class="label">教练</text><text class="value">{{booking.coachName}}</text></view></block><block wx:if="{{booking.createTime}}"><view class="row"><text class="label">下单时间</text><text class="value">{{$root.m0}}</text></view></block></view></block><block wx:else><view class="loading">加载中...</view></block><block wx:if="{{booking&&booking.status==='booked'&&canCancel}}"><button data-event-opts="{{[['tap',[['onCancel',['$event']]]]]}}" class="cancel-btn" bindtap="__e"> 取消预约 </button></block><block wx:if="{{booking&&booking.status==='booked'&&!canCancel}}"><view class="tip">{{''+tipText+''}}</view></block></view>