<view class="page"><view class="title">我的会员卡</view><block wx:if="{{$root.g0}}"><view class="empty"><view class="empty-text">暂无会员卡</view><view class="empty-tip">请联系场馆前台办理</view></view></block><block wx:else><view class="list"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index"><view class="{{['card',item.m0]}}"><view class="card-top"><view class="card-name">{{item.$orig.cardName}}</view><view class="card-type">{{item.m1}}</view></view><view class="card-body"><block wx:if="{{item.m2}}"><view class="times"><view class="times-main"><text class="num">{{item.$orig.remainingTimes}}</text><text class="unit">次</text></view><view class="times-sub">{{"剩余 / 共 "+item.$orig.totalTimes+" 次"}}</view></view></block><block wx:else><view class="times"><view class="times-main"><text class="num">{{item.m3}}</text><text class="unit">天</text></view><view class="times-sub">剩余有效天数</view></view></block><block wx:if="{{item.$orig.validFrom||item.$orig.validTo}}"><view class="valid">{{'有效期：'+(item.$orig.validFrom||'不限')+" ~ "+(item.$orig.validTo||'不限')+''}}</view></block></view><view class="card-status">{{item.m4}}</view></view></block></view></block></view>