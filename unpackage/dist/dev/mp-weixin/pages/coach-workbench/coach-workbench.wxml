<view class="page"><block wx:if="{{coachInfo}}"><view class="profile-card"><view class="profile-header"><image class="avatar" src="{{coachInfo.avatar||'/static/images/avatar.png'}}" mode="aspectFill"></image><view class="info"><view class="name">{{coachInfo.name}}</view><view class="title">{{coachInfo.title||'教练'}}</view></view><view data-event-opts="{{[['tap',[['goEditProfile',['$event']]]]]}}" class="edit-btn" bindtap="__e">编辑资料</view></view><view class="desc">{{coachInfo.desc||coachInfo.remark||'暂无介绍'}}</view></view></block><block wx:if="{{!coachInfo&&!loading}}"><view class="bind-card"><view class="bind-title">未找到教练资料</view><view class="bind-desc">请联系管理员在后台添加教练账号，并保证手机号与登录手机号一致</view></view></block><block wx:if="{{coachInfo}}"><view class="section-title">我的课程安排</view></block><block wx:if="{{$root.g0}}"><view class="empty"><view class="empty-text">暂无预约课程</view></view></block><block wx:if="{{coachInfo}}"><view class="list"><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="item"><view class="item-left"><view class="date">{{item.date}}</view><view class="time">{{item.time}}</view><view class="court">{{"场地："+item.court}}</view><block wx:if="{{item.userName}}"><view class="user">{{"学员："+item.userName}}</view></block></view><view class="status booked">已预约</view></view></block></view></block><block wx:if="{{loading}}"><view class="loading">加载中...</view></block></view>