<view class="page"><block wx:if="{{coachInfo}}"><view class="profile-card"><view class="profile-header"><image class="avatar" src="{{coachInfo.avatar||'/images/avatar.png'}}" mode="aspectFill"></image><view class="info"><view class="name">{{coachInfo.name}}</view><view class="title">{{coachInfo.title}}</view></view><view data-event-opts="{{[['tap',[['goEditProfile',['$event']]]]]}}" class="edit-btn" bindtap="__e">编辑资料</view></view><view class="desc">{{coachInfo.desc||'暂无介绍'}}</view></view></block><block wx:if="{{!coachInfo&&!loading}}"><view class="bind-card"><view class="bind-title">您还没有完善教练资料</view><view class="bind-desc">完善后学员才能预约您的课程</view><button data-event-opts="{{[['tap',[['createCoachProfile',['$event']]]]]}}" class="bind-btn" bindtap="__e">立即完善资料</button></view></block><block wx:if="{{coachInfo}}"><view class="section-title">我的课程安排</view></block><block wx:if="{{$root.g0}}"><view class="empty"><view class="empty-text">暂无预约课程</view></view></block><block wx:if="{{coachInfo}}"><view class="list"><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="item"><view class="item-left"><view class="date">{{item.date}}</view><view class="time">{{item.time}}</view><view class="court">{{"场地："+item.court}}</view></view><view class="status booked">已预约</view></view></block></view></block><block wx:if="{{loading}}"><view class="loading">加载中...</view></block></view>