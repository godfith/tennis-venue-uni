<view class="page"><block wx:if="{{!isLogin}}"><block><view class="login-box"><view class="login-title">成为 Goat 会员</view><view class="login-desc">登录后可订场、查看余额和会员卡</view><button data-event-opts="{{[['tap',[['goLogin',['$event']]]]]}}" class="login-btn" bindtap="__e">去登录</button></view></block></block><block wx:else><block><view class="head"><image class="avatar" src="{{avatarUrl||'/static/images/avatar.png'}}" mode="aspectFill"></image><view class="name">{{nickName}}</view><block wx:if="{{phone}}"><view class="since">{{phone}}</view></block><view class="since muted">山羊Goat网球馆会员</view><view data-event-opts="{{[['tap',[['openEdit',['$event']]]]]}}" class="edit-btn" bindtap="__e">修改头像昵称</view></view><block wx:if="{{editing}}"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="edit-mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="edit-card" catchtap="__e"><view class="edit-title">修改资料</view><button class="avatar-btn" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><image class="avatar" src="{{editAvatar||avatarUrl||'/static/images/avatar.png'}}" mode="aspectFill"></image></button><input class="edit-input" type="nickname" placeholder="输入昵称" data-event-opts="{{[['input',[['onNick',['$event']]]],['blur',[['onNick',['$event']]]]]}}" value="{{editNick}}" bindinput="__e" bindblur="__e"/><button class="save-btn" loading="{{saving}}" data-event-opts="{{[['tap',[['saveProfile',['$event']]]]]}}" bindtap="__e">保存</button></view></view></block><view class="wallet"><view class="w-item"><view class="w-lab">现金余额</view><view class="w-num">{{"¥"+$root.g0}}</view><view class="w-tip">订场可直接抵扣</view></view><view class="w-item"><view class="w-lab">积分</view><view class="w-num">{{points||0}}</view><view class="w-tip">暂不抵扣</view></view></view><view class="triple"><view data-event-opts="{{[['tap',[['goMyCards',['$event']]]]]}}" class="t-item" bindtap="__e"><image class="t-ico" src="/static/images/ui/ico-card.png"></image><view class="t-n">卡券</view></view><view data-event-opts="{{[['tap',[['goMyBooking',['$event']]]]]}}" class="t-item" bindtap="__e"><image class="t-ico" src="/static/images/ui/ico-book.png"></image><view class="t-n">我的预约</view></view><view data-event-opts="{{[['tap',[['goMyCards',['$event']]]]]}}" class="t-item" bindtap="__e"><image class="t-ico" src="/static/images/ui/ico-member.png"></image><view class="t-n">会员卡</view></view></view><view class="menu"><view data-event-opts="{{[['tap',[['goMyBooking',['$event']]]]]}}" class="menu-row" bindtap="__e"><image class="m-ico" src="/static/images/tab/rank-on.png"></image><text class="m-name">订单中心</text><text class="en">MY ORDERS</text><text class="arrow">›</text></view><view data-event-opts="{{[['tap',[['goMyEval',['$event']]]]]}}" class="menu-row" bindtap="__e"><image class="m-ico" src="/static/images/tab/rank-on.png"></image><text class="m-name">我的评测</text><text class="en">MY EVALUATION</text><text class="arrow">›</text></view><view data-event-opts="{{[['tap',[['goMyCards',['$event']]]]]}}" class="menu-row" bindtap="__e"><image class="m-ico" src="/static/images/tab/shop-on.png"></image><text class="m-name">我的会员卡</text><text class="en">MY CARDS</text><text class="arrow">›</text></view><block wx:if="{{role==='coach'}}"><view data-event-opts="{{[['tap',[['goCoachWorkbench',['$event']]]]]}}" class="menu-row" bindtap="__e"><image class="m-ico" src="/static/images/tab/book-on.png"></image><text class="m-name">教练工作台</text><text class="en">WORKBENCH</text><text class="arrow">›</text></view></block><view data-event-opts="{{[['tap',[['comingSoon',['$event']]]]]}}" class="menu-row" bindtap="__e"><image class="m-ico" src="/static/images/tab/mine-on.png"></image><text class="m-name">个人资料</text><text class="en">PERSONAL INFO</text><text class="arrow">›</text></view><view data-event-opts="{{[['tap',[['comingSoon',['$event']]]]]}}" class="menu-row" bindtap="__e"><image class="m-ico" src="/static/images/tab/home-on.png"></image><text class="m-name">联系客服</text><text class="en">CONTACT</text><text class="arrow">›</text></view></view><view data-event-opts="{{[['tap',[['logout',['$event']]]]]}}" class="logout" bindtap="__e">退出登录</view></block></block><app-tabbar vue-id="704e9d00-1" current="{{2}}" bind:__l="__l"></app-tabbar></view>