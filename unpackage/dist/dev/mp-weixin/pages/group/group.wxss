
.page {
  min-height: 100vh;
  background: #f4f2ee;
  padding-bottom: 40rpx;
}
.header {
  background: #fff;
  padding: 24rpx 30rpx 12rpx;
}
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}
.cal-btn {
  display: flex;
  align-items: center;
  background: #1a5c3a;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}
.cal-ico { font-size: 26rpx; margin-right: 6rpx;
}
.cal-txt { font-size: 24rpx; color: #fff; font-weight: 600;
}
.date-scroll {
  background: #fff;
  padding: 10rpx 20rpx 24rpx;
  white-space: nowrap;
  width: 100%;
}
.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 120rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  color: #333;
}
.date-item.active {
  background: #1a5c3a;
  color: #fff;
}
.week { font-size: 22rpx; opacity: 0.8;
}
.day { font-size: 36rpx; font-weight: 700; margin-bottom: 4rpx;
}
.filters {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 0;
  gap: 12rpx;
}
.chip-scroll {
  flex: 1;
  white-space: nowrap;
  height: 64rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 26rpx;
  background: #fff;
  color: #333;
  font-size: 24rpx;
  flex-shrink: 0;
}
.chip.on {
  background: #1a5c3a;
  color: #fff;
  font-weight: 600;
}
.tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}
.list { padding: 20rpx 24rpx 40rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e8f0eb;
  color: #1a5c3a;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.avatar-img { width: 88rpx; height: 88rpx;
}
.mid { flex: 1; min-width: 0;
}
.name { font-size: 30rpx; font-weight: 700; color: #222;
}
.time { font-size: 26rpx; color: #1a5c3a; margin-top: 6rpx; font-weight: 600;
}
.tags { margin-top: 8rpx;
}
.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #666;
  background: #f4f2ee;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
  margin-top: 4rpx;
}
.tag.warn { background: #fff4e0; color: #c47b14;
}
.right { margin-left: 12rpx; flex-shrink: 0;
}
.btn {
  background: #1a5c3a !important;
  color: #fff !important;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  height: 64rpx;
  padding: 0 28rpx;
  margin: 0;
}
.btn.full {
  background: #ccc !important;
  color: #fff !important;
}
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 30rpx 50rpx;
  box-sizing: border-box;
}
.sheet-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx;
}
.row { font-size: 26rpx; color: #666; margin-top: 8rpx;
}
.label { margin-top: 24rpx; margin-bottom: 12rpx; font-size: 28rpx; font-weight: 600;
}
.err { color: #f56c6c; font-size: 26rpx;
}
.card-opt {
  padding: 22rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}
.card-opt.on {
  border-color: #1a5c3a;
  background: #f0f6f2;
  color: #1a5c3a;
}
.card-store { font-size: 22rpx; color: #888; margin-top: 6rpx;
}
.confirm {
  margin-top: 24rpx;
  background: #1a5c3a !important;
  color: #fff !important;
  border-radius: 12rpx;
}
.cancel {
  margin-top: 16rpx;
  background: #f5f5f5 !important;
  color: #666 !important;
  border-radius: 12rpx;
}
.mask-center { align-items: center;
}
.cal-pop {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  width: 640rpx;
}
.cal-head { display: flex; align-items: center; margin-bottom: 16rpx;
}
.cal-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 600;
}
.cal-nav, .cal-close {
  width: 56rpx; height: 56rpx;
  text-align: center; line-height: 56rpx;
  font-size: 36rpx; color: #1a5c3a;
}
.cal-weeks, .cal-grid { display: flex; flex-wrap: wrap;
}
.cal-w, .cal-d { width: 14.28%; text-align: center; font-size: 24rpx;
}
.cal-w { color: #999; padding: 8rpx 0;
}
.cal-d { height: 80rpx; color: #333; padding-top: 20rpx;
}
.cal-d.out { color: #ccc;
}
.cal-d.on { background: #1a5c3a; color: #fff; border-radius: 8rpx;
}

