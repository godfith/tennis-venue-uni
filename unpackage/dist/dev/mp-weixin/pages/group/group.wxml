<view class="page"><view class="header"><view class="header-row"><view class="title">团课报名</view><view data-event-opts="{{[['tap',[['openCal',['$event']]]]]}}" class="cal-btn" bindtap="__e"><text class="cal-ico">📅</text><text class="cal-txt">月历</text></view></view></view><scroll-view class="date-scroll" scroll-x="true" scroll-into-view="{{scrollTo}}" enable-flex="{{true}}"><block wx:for="{{dateList}}" wx:for-item="item" wx:for-index="index" wx:key="date"><view class="{{['date-item',(currentDate===item.date)?'active':'']}}" id="{{'d'+item.date}}" data-date="{{item.date}}" data-event-opts="{{[['tap',[['onDateTap',['$event']]]]]}}" bindtap="__e"><view class="day">{{item.dayNum}}</view><view class="week">{{item.week}}</view></view></block></scroll-view><view class="filters"><view class="{{['chip',(!nameFilter)?'on':'']}}" data-val data-event-opts="{{[['tap',[['onNameChip',['$event']]]]]}}" bindtap="__e">课程</view><scroll-view class="chip-scroll" scroll-x="true"><block wx:for="{{classNames}}" wx:for-item="n" wx:for-index="__i0__"><view class="{{['chip',(nameFilter===n)?'on':'']}}" data-val="{{n}}" data-event-opts="{{[['tap',[['onNameChip',['$event']]]]]}}" bindtap="__e">{{n}}</view></block></scroll-view></view><view class="filters"><view class="{{['chip',(!venueFilter)?'on':'']}}" data-val data-event-opts="{{[['tap',[['onVenueChip',['$event']]]]]}}" bindtap="__e">全部</view><scroll-view class="chip-scroll" scroll-x="true"><block wx:for="{{$root.l0}}" wx:for-item="v" wx:for-index="__i1__"><view class="{{['chip',(venueFilter===v.m0)?'on':'']}}" data-val="{{v.$orig.venueId}}" data-event-opts="{{[['tap',[['onVenueChip',['$event']]]]]}}" bindtap="__e">{{v.$orig.name}}</view></block></scroll-view></view><view class="filters"><view class="{{['chip',(timeFilter==='')?'on':'']}}" data-val data-event-opts="{{[['tap',[['onTimeChip',['$event']]]]]}}" bindtap="__e">时间</view><view class="{{['chip',(timeFilter==='morning')?'on':'']}}" data-val="morning" data-event-opts="{{[['tap',[['onTimeChip',['$event']]]]]}}" bindtap="__e">上午</view><view class="{{['chip',(timeFilter==='afternoon')?'on':'']}}" data-val="afternoon" data-event-opts="{{[['tap',[['onTimeChip',['$event']]]]]}}" bindtap="__e">下午</view><view class="{{['chip',(timeFilter==='evening')?'on':'']}}" data-val="evening" data-event-opts="{{[['tap',[['onTimeChip',['$event']]]]]}}" bindtap="__e">晚上</view></view><view class="filters"><view class="{{['chip',(typeFilter==='')?'on':'']}}" data-val data-event-opts="{{[['tap',[['onTypeChip',['$event']]]]]}}" bindtap="__e">全部类型</view><view class="{{['chip',(typeFilter==='fixed')?'on':'']}}" data-val="fixed" data-event-opts="{{[['tap',[['onTypeChip',['$event']]]]]}}" bindtap="__e">固定团课</view><view class="{{['chip',(typeFilter==='self')?'on':'']}}" data-val="self" data-event-opts="{{[['tap',[['onTypeChip',['$event']]]]]}}" bindtap="__e">自组团课</view></view><block wx:if="{{loading}}"><view class="tip">加载中...</view></block><block wx:else><block wx:if="{{$root.g0===0}}"><view class="tip">当天暂无团课</view></block><block wx:else><view class="list"><block wx:for="{{$root.l1}}" wx:for-item="item" wx:for-index="index"><view class="card"><view class="avatar" style="{{(item.m1)}}"><block wx:if="{{item.$orig.coachAvatar}}"><image class="avatar-img" src="{{item.$orig.coachAvatar}}" mode="aspectFill"></image></block><block wx:else><text>{{item.m2}}</text></block></view><view class="mid"><view class="name">{{item.$orig.name}}</view><block wx:if="{{item.$orig.theme}}"><view class="theme">{{item.$orig.theme}}</view></block><view class="time">{{item.$orig.time}}</view><view class="tags"><text class="tag">{{item.m3}}</text><block wx:if="{{item.$orig.court}}"><text class="tag">{{item.$orig.court}}</text></block><block wx:if="{{item.$orig.coachName}}"><text class="tag">{{item.$orig.coachName}}</text></block><text class="tag">{{(item.$orig.enrolled||0)+"/"+(item.$orig.capacity||0)}}</text><block wx:if="{{item.$orig.venueName}}"><text class="tag">{{item.$orig.venueName}}</text></block><block wx:if="{{item.m4}}"><text class="tag warn">临时</text></block></view></view><view class="right"><button class="{{['btn',(!item.m5)?'full':'']}}" disabled="{{!item.m6}}" data-event-opts="{{[['tap',[['openEnroll',['$0'],[[['filteredList','_id||index',item.$orig._id||index]]]]]]]}}" bindtap="__e">{{item.m7}}</button></view></view></block></view></block></block><block wx:if="{{show}}"><view data-event-opts="{{[['tap',[['closeSheet',['$event']]]]]}}" class="mask" bindtap="__e"><view data-event-opts="{{[['tap',[['stopBubble',['$event']]]]]}}" class="sheet" catchtap="__e"><view class="sheet-title">确认报名</view><view class="row">{{current.name+" · "+current.time}}</view><view class="row">{{$root.m8}}<block wx:if="{{current.theme}}"><text>{{'· '+current.theme}}</text></block></view><view class="row">{{(current.venueName||'')+" "+current.court+" · 教练 "+(current.coachName||'-')}}</view><view class="label">选择团课卡</view><block wx:if="{{$root.g1===0}}"><view class="err">没有可用团课卡，请联系前台</view></block><block wx:for="{{cards}}" wx:for-item="c" wx:for-index="i"><view data-event-opts="{{[['tap',[['selectCard',['$0'],[[['cards','_id||i',c._id||i,'_id']]]]]]]}}" class="{{['card-opt',(selectedCardId===c._id)?'on':'']}}" bindtap="__e"><view>{{c.cardName+"（剩"+c.remainingTimes+"次）"}}</view><block wx:if="{{c.venueName}}"><view class="card-store">{{"发卡门店："+c.venueName}}</view></block></view></block><button class="confirm" loading="{{saving}}" data-event-opts="{{[['tap',[['submit',['$event']]]]]}}" bindtap="__e">确认报名并扣次</button><button data-event-opts="{{[['tap',[['closeSheet',['$event']]]]]}}" class="cancel" bindtap="__e">取消</button></view></view></block><block wx:if="{{calOpen}}"><view data-event-opts="{{[['tap',[['closeCal',['$event']]]]]}}" class="mask mask-center" bindtap="__e"><view data-event-opts="{{[['tap',[['stopBubble',['$event']]]]]}}" class="cal-pop" catchtap="__e"><view class="cal-head"><view data-event-opts="{{[['tap',[['prevMonth',['$event']]]]]}}" class="cal-nav" bindtap="__e">‹</view><view class="cal-title">{{calYear+"年"+calMonth+"月"}}</view><view data-event-opts="{{[['tap',[['nextMonth',['$event']]]]]}}" class="cal-nav" bindtap="__e">›</view><view data-event-opts="{{[['tap',[['closeCal',['$event']]]]]}}" class="cal-close" bindtap="__e">×</view></view><view class="cal-weeks"><block wx:for="{{weekLabels}}" wx:for-item="w" wx:for-index="__i2__" wx:key="*this"><view class="cal-w">{{w}}</view></block></view><view class="cal-grid"><block wx:for="{{calDays}}" wx:for-item="d" wx:for-index="i" wx:key="i"><view class="{{['cal-d '+(d.date===currentDate?'on':'')+(d.inMonth?'':' out')]}}" data-date="{{d.date}}" data-ok="{{d.inMonth?1:0}}" data-event-opts="{{[['tap',[['onCalDayTap',['$event']]]]]}}" bindtap="__e"><text>{{d.day}}</text></view></block></view></view></view></block></view>