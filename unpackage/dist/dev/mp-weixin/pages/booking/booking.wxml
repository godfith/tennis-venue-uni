消</view></view></view></block><block wx:if="{{cardSheetVisible}}"><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="sheet" catchtap="__e"><view class="sheet-title">确认预约</view><view class="sheet-sub">{{venueName}}</view><view class="sheet-sub">{{currentCourtName+" · "+currentDate+" "+currentTime}}</view><block wx:if="{{currentPrice>0}}"><view class="sheet-price">{{"场地参考价 ¥"+currentPrice}}</view></block><block wx:if="{{currentPrice>0}}"><view data-event-opts="{{[['tap',[['pickWxPay',['$event']]]]]}}" class="{{['card-option',payWay==='wx'?'on':'']}}" bindtap="__e"><view class="co-name">微信支付</view><view class="co-meta">{{"在线支付 ¥"+currentPrice}}</view></view></block><block wx:if="{{currentPrice>0}}"><view data-event-opts="{{[['tap',[['pickBalancePay',['$event']]]]]}}" class="{{['card-option',payWay==='balance'?'on':walletBalance+0.001<currentPrice?'off':'']}}" bindtap="__e"><view class="co-name">现金余额</view><block wx:if="{{walletBalance+0.001>=currentPrice}}"><view class="co-meta">{{"余额 ¥"+$root.g4+"，本场扣 ¥"+currentPrice}}</view></block><block wx:else><view class="co-meta">{{"余额 ¥"+$root.g5+"，不足本场 ¥"+currentPrice}}</view></block></view></block><block wx:for="{{$root.l2}}" wx:for-item="c" wx:for-index="__i1__" wx:key="_id"><view data-event-opts="{{[['tap',[['pickCardPay',['$0'],[[['usableCards','_id',c.$orig._id,'_id']]]]]]]}}" class="{{['card-option',payWay==='card'&&selectedCardId===c.$orig._id?'on':'']}}" bindtap="__e"><view class="co-name">{{c.$orig.cardName}}</view><view class="co-meta">{{c.m1}}</view></view></block><block wx:if="{{$root.g6}}"><view class="sheet-empty">{{noUsableCardText}}</view></block><button class="sheet-btn" loading="{{booking}}" data-event-opts="{{[['tap',[['submitBook',['$event']]]]]}}" bindtap="__e">{{"确认预约 "+venueName}}</button><view data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="sheet-cancel" bindtap="__e">取消</view></view></view></bloc