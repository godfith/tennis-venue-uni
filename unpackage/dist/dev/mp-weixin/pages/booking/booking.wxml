<view><view class="container"><view class="header"><view class="title">{{venueName||'网球场馆预约'}}</view><block wx:if="{{venueName}}"><view class="sub-title">场地预约</view></block></view><scroll-view class="date-scroll" scroll-x="{{true}}" enable-flex="{{true}}"><block wx:for="{{dateList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['onSelectDate',['$0'],[[['dateList','',index,'date']]]]]]]}}" class="{{['date-item '+(currentDate===item.date?'active':'')]}}" bindtap="__e"><view class="week">{{item.week}}</view><view class="day">{{item.day}}</view></view></block></scroll-view><view class="court-area"><block wx:for="{{courtList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="court-card"><view class="court-header"><text class="court-name">{{item.name}}</text><text class="court-desc">{{item.desc}}</text></view><view class="time-grid"><block wx:for="{{item.times}}" wx:for-item="cell" wx:for-index="index1" wx:key="index1"><view data-event-opts="{{[['tap',[['onSelectSlot',['$0','$1','$2','$3'],[[['courtList','',index,'id']],[['courtList','',index,'name']],[['courtList','',index],['times','',index1,'time']],[['courtList','',index],['times','',index1,'status']]]]]]]}}" class="{{['time-cell '+(cell.status==='full'?'full':'')+' '+(currentCourtId===item.id&&currentTime===cell.time?'selected':'')]}}" bindtap="__e"><view class="time-text">{{cell.short}}</view><view class="status-text">{{cell.status==='full'?'已租':'可约'}}</view></view></block></view></view></block></view><block wx:if="{{currentCourtId}}"><view class="bottom-bar"><view class="selected-info"><view>{{currentCourtName}}</view><view class="selected-time">{{currentTime}}</view></view><button data-event-opts="{{[['tap',[['onBook',['$event']]]]]}}" class="book-btn" bindtap="__e">确认预约</button></view></block></view></view>