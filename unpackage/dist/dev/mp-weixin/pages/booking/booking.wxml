<view><view class="container"><view class="header"><view class="title">网球场馆预约</view></view><scroll-view class="date-scroll" scroll-x="{{true}}" enable-flex="{{true}}"><block wx:for="{{dateList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['date-item '+(currentDate===item.date?'active':'')]}}" data-date="{{item.date}}" data-event-opts="{{[['tap',[['onSelectDate',['$event']]]]]}}" bindtap="__e"><view class="week">{{item.week}}</view><view class="day">{{item.day}}</view></view></block></scroll-view><view class="court-area"><block wx:for="{{courtList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="court-card"><view class="court-header"><text class="court-name">{{item.name}}</text><text class="court-desc">{{item.desc}}</text></view><view class="time-grid"><block wx:for="{{item.times}}" wx:for-item="cell" wx:for-index="index1" wx:key="index1"><view class="{{['time-cell '+(cell.status==='full'?'full':'')+' '+(currentCourtId===item.id&&currentTime===cell.time?'selected':'')]}}" data-court-id="{{item.id}}" data-court-name="{{item.name}}" data-time="{{cell.time}}" data-status="{{cell.status}}" data-event-opts="{{[['tap',[['onSelectSlot',['$event']]]]]}}" bindtap="__e"><view class="time-text">{{cell.short}}</view><view class="status-text">{{cell.status==='full'?'已租':'可约'}}</view></view></block></view></view></block></view><block wx:if="{{currentCourtId}}"><view class="bottom-bar"><view class="selected-info"><view>{{currentCourtName}}</view><view class="selected-time">{{currentTime}}</view></view><button data-event-opts="{{[['tap',[['onBook',['$event']]]]]}}" class="book-btn" bindtap="__e">确认预约</button></view></block></view></view>