<view class="page"><view class="avatar-section"><button class="avatar-btn" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><image class="avatar" src="{{avatar||'/images/avatar.png'}}" mode="aspectFill"></image><view class="avatar-tip">点击更换头像</view></button></view><view class="form-item"><view class="label">姓名</view><input class="input" placeholder="请输入姓名" data-event-opts="{{[['input',[['onNameInput',['$event']]]]]}}" value="{{name}}" bindinput="__e"/></view><view class="form-item"><view class="label">头衔</view><input class="input" placeholder="例如：高级教练 · 10年经验" data-event-opts="{{[['input',[['onTitleInput',['$event']]]]]}}" value="{{title}}" bindinput="__e"/></view><view class="form-item"><view class="label">个人介绍</view><textarea class="textarea" placeholder="请输入个人介绍" maxlength="200" data-event-opts="{{[['input',[['onDescInput',['$event']]]]]}}" value="{{desc}}" bindinput="__e"></textarea></view><view class="form-item"><view class="label">标签（用逗号分隔）</view><input class="input" placeholder="例如：底线,战术,青少年" data-event-opts="{{[['input',[['onTagsInput',['$event']]]]]}}" value="{{tagsStr}}" bindinput="__e"/></view><button data-event-opts="{{[['tap',[['onSave',['$event']]]]]}}" class="save-btn" bindtap="__e">保存</button></view>