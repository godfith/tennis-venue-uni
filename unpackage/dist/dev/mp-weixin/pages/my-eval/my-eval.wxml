<view class="page"><block wx:if="{{latest}}"><view class="card"><canvas class="radar" canvas-id="radar" id="radar"></canvas><view class="total">{{"总分 "+latest.total}}</view><view class="scores"><view class="score-item"><text>正手</text><text>{{latest.forehand}}</text></view><view class="score-item"><text>反手</text><text>{{latest.backhand}}</text></view><view class="score-item"><text>发球</text><text>{{latest.serve}}</text></view><view class="score-item"><text>截击</text><text>{{latest.volley}}</text></view><view class="score-item"><text>切削</text><text>{{latest.slice}}</text></view><view class="score-item"><text>高压</text><text>{{latest.smash}}</text></view><view class="score-item"><text>放小球</text><text>{{latest.drop_shot}}</text></view></view><view class="coach">{{"教练："+(latest.coach_name||'-')}}</view><view class="time">{{latest.created_at}}</view></view></block><block wx:else><view class="empty">暂无评测记录</view></block><block wx:if="{{$root.g0>1}}"><view class="history"><view class="hist-title">历史评测</view><block wx:for="{{$root.l0}}" wx:for-item="h" wx:for-index="i" wx:key="i"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({h})}}" class="hist-item" bindtap="__e"><text>{{h.created_at}}</text><text>{{"总分 "+h.total}}</text></view></block></view></block></view>