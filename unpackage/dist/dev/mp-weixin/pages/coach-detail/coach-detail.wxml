<view><block wx:if="{{coach}}"><view class="page"><view class="header-card"><image class="avatar" src="{{coach.avatar}}" mode="aspectFill"></image><view class="name">{{coach.name}}</view><view class="title">{{coach.title}}</view><view class="tags"><block wx:for="{{coach.tags}}" wx:for-item="item" wx:for-index="index" wx:key="index"><text class="tag">{{item}}</text></block></view></view><view class="section"><view class="section-title">教练介绍</view><view class="desc">{{coach.desc||'暂无详细介绍'}}</view></view><view class="section"><view class="section-title">1. 选择上课时间</view><scroll-view class="date-list" scroll-x="{{true}}" enable-flex="{{true}}"><block wx:for="{{dateList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['onSelectDate',['$0'],[[['dateList','',index,'date']]]]]]]}}" class="{{['date-item '+(currentDate===item.date?'active':'')]}}" bindtap="__e"><view class="week">{{item.week}}</view><view class="day">{{item.day}}</view></view></block></scroll-view><view class="time-list"><block wx:for="{{timeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['onSelectTime',['$0','$1'],[[['timeList','',index,'time']],[['timeList','',index,'status']]]]]]]}}" class="{{['time-item '+(item.status==='full'?'full':'')+' '+(currentTime===item.time?'active':'')]}}" bindtap="__e">{{''+item.time+''}}<block wx:if="{{item.status==='full'}}"><text class="status-text">已满</text></block></view></block></view></view><block wx:if="{{currentTime}}"><view class="section"><view class="section-title">2. 选择场地</view><block wx:if="{{$root.g0>0}}"><view class="court-list"><block wx:for="{{availableCourts}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['onSelectCourt',['$0'],[[['availableCourts','',index]]]]]]]}}" class="{{['court-item '+(currentCourt===item?'active':'')]}}" bindtap="__e">{{''+item+''}}</view></block></view></block><block wx:else><view class="no-court">该时间段暂无空闲场地</view></block></view></block><view class="bottom-bar"><block wx:if="{{currentDate&&currentTime&&currentCourt}}"><view class="selected-info">{{currentDate+" "+currentTime+" · "+currentCourt}}</view></block><button class="book-btn" disabled="{{!currentDate||!currentTime||!currentCourt}}" data-event-opts="{{[['tap',[['onBook',['$event']]]]]}}" bindtap="__e">立即预约</button></view></view></block><block wx:else><view class="loading">加载中...</view></block></view>