<view><block wx:if="{{coach}}"><view class="page"><view class="top"><view class="top-l"><view class="hello">{{coach.name}}</view><view class="venue">{{(coach.title||'专业教练')+" · "+venueName}}</view></view></view><view class="tabs"><view data-event-opts="{{[['tap',[['goBook',['$event']]]]]}}" class="tab" bindtap="__e">订场</view><view class="tab on">私教</view></view><scroll-view class="dates" scroll-x="{{true}}" enable-flex="{{true}}"><block wx:for="{{dateList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['onSelectDate',['$0'],[[['dateList','',index,'date']]]]]]]}}" class="{{['date '+(currentDate===item.date?'on':'')]}}" bindtap="__e"><view class="d-md">{{item.md}}</view><view class="d-wk">{{item.week}}</view></view></block></scroll-view><view class="board"><view class="left"><view class="left-lab">场地</view><block wx:for="{{courtList}}" wx:for-item="c" wx:for-index="__i0__" wx:key="*this"><view data-event-opts="{{[['tap',[['onSelectCourt',['$0'],[[['courtList','',__i0__]]]]]]]}}" class="{{['l-item '+(currentCourt===c?'on':'')]}}" bindtap="__e">{{c}}</view></block><block wx:if="{{!$root.g0}}"><view class="left-lab">暂无场地</view></block></view><view class="right"><block wx:for="{{timeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['onSelectTime',['$0','$1'],[[['timeList','',index,'time']],[['timeList','',index,'status']]]]]]]}}" class="{{['slot '+(item.status==='full'?'off':'')+' '+(currentTime===item.time?'sel':'')]}}" bindtap="__e"><text>{{item.time}}</text><block wx:if="{{item.status==='full'}}"><text class="st">已满</text></block></view></block><block wx:if="{{!$root.g1}}"><view class="empty">暂无时段</view></block></view></view></view></block><block wx:else><view class="empty">加载中...</view></block><block wx:if="{{coach}}"><view class="bar"><view><view class="sum">{{coach.name}}</view><view class="picked">{{(currentCourt||'未选场地')+" "+currentTime}}</view></view><button class="ok" disabled="{{!currentDate||!currentTime||!currentCourt||booking}}" loading="{{booking}}" data-event-opts="{{[['tap',[['onBook',['$event']]]]]}}" bindtap="__e">确认约课</button></view></block><block wx:if="{{cardSheetVisible}}"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="sheet" catchtap="__e"><view class="sheet-title">选择支付方式</view><view class="sheet-sub">{{coach.name+" · "+pending.date+" "+pending.time+" · "+pending.court}}</view><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="{{['card-option',selectedCardId===''?'on':'']}}" bindtap="__e"><view class="co-name">到店支付课时费</view></view><block wx:for="{{usableCards}}" wx:for-item="c" wx:for-index="__i1__" wx:key="_id"><view data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" data-event-params="{{({c})}}" class="{{['card-option',selectedCardId===c._id?'on':'']}}" bindtap="__e"><view class="co-name">{{c.cardName}}</view><view class="co-meta">{{"教练卡 · 剩"+(c.remainingTimes||0)+"次"}}</view></view></block><block wx:if="{{$root.g2}}"><view class="sheet-empty">暂无可用教练卡</view></block><button class="sheet-btn" loading="{{booking}}" data-event-opts="{{[['tap',[['submitBook',['$event']]]]]}}" bindtap="__e">确认预约</button><view data-event-opts="{{[['tap',[['e3',['$event']]]]]}}" class="sheet-cancel" bindtap="__e">取消</view></view></view></block></view>